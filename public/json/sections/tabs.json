  {
    "tag": "script",
    "text": "/* @component: .tabs */ (function () { if (window.__tabsInit) return; window.__tabsInit = true; document.addEventListener('click', function (e) { const target = e.target instanceof Element ? e.target : null; if (!target) return; const btn = target.closest('.tabs__btn'); if (!btn) return; if (btn.tagName === 'A') e.preventDefault(); const tabsContainer = btn.closest('.tabs'); if (!tabsContainer) return; const allBtns = Array.from(tabsContainer.querySelectorAll('.tabs__btn')).filter((el) => el.closest('.tabs') === tabsContainer); const allPanes = Array.from(tabsContainer.querySelectorAll('.tabs__pane')).filter((el) => el.closest('.tabs') === tabsContainer); const index = allBtns.indexOf(btn); if (index === -1) return; allBtns.forEach((b) => b.classList.remove('_is-active')); btn.classList.add('_is-active'); allPanes.forEach((p) => p.classList.remove('_is-active')); if (allPanes[index]) allPanes[index].classList.add('_is-active'); }); })(); /* @end: .tabs */",
