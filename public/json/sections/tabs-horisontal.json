  {
    "tag": "style",
    "text": "\n  @keyframes fadeIn {\n    from {\n      opacity: 0;\n    \n    }\n\n    to {\n      opacity: 1;\n      \n    }\n  }\n",
    "class": "",
    "style": "",
    "children": [],
    "attributes": {}
  },
  {
    "tag": "script",
    "text": "/* @component: .tabsG */\r\ndocument.addEventListener('click', function (e) {\r\n  const btn = e.target.closest('.tabsG__btn');\r\n  if (btn) {\r\n    const tabsGContainer = btn.closest('.tabsG');\r\n    const allBtns = tabsGContainer.querySelectorAll('.tabsG__btn');\r\n    const allPanes = tabsGContainer.querySelectorAll('.tabsG__pane');\r\n    const index = Array.from(allBtns).indexOf(btn);\r\n\r\n    // 1. Сбрасываем и вешаем активный класс у кнопок\r\n    allBtns.forEach(b => b.classList.remove('_is-active'));\r\n    btn.classList.add('_is-active');\r\n\r\n    if (allPanes[index]) {\r\n      // 2. Гасим все активные панели\r\n      allPanes.forEach(p => p.classList.remove('_is-active'));\r\n\r\n      // 3. Вычисляем точный отступ кнопки сверху относительно контейнера\r\n      const containerRect = tabsGContainer.getBoundingClientRect();\r\n      const btnRect = btn.getBoundingClientRect();\r\n      const btnOffsetTop = btnRect.top - containerRect.top;\r\n\r\n      // 4. Просто задаем этот отступ через marginTop\r\n      allPanes[index].style.marginTop = `${btnOffsetTop}px`;\r\n\r\n      // 5. Делаем панель видимой — она сама раздвинет родителя по высоте!\r\n      allPanes[index].classList.add('_is-active');\r\n    }\r\n  }\r\n});",
    "class": "",
    "children": [],
    "attributes": {}
  }
