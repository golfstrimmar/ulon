  {
    "tag": "script",
    "text": "/* @component: .tabs -uno */ (function () { if (window.__tabsInit) return; window.__tabsInit = true; document.addEventListener('click', function (e) { const btn = e.target.closest('.tabs__btn'); if (btn) { const tabsContainer = btn.closest('.tabs'); if (!tabsContainer) return; const allBtns = tabsContainer.querySelectorAll('.tabs__btn'); const allPanes = tabsContainer.querySelectorAll('.tabs__pane'); const index = Array.from(allBtns).indexOf(btn); allBtns.forEach((b) => { if (b !== btn) { b.classList.remove('_is-active'); } }); const isNowActive = btn.classList.toggle('_is-active'); allPanes.forEach((p) => p.classList.remove('_is-active')); if (isNowActive && allPanes[index]) { allPanes[index].classList.add('_is-active'); } } else if (!e.target.closest('.tabs')) { document.querySelectorAll('.tabs__btn, .tabs__pane').forEach((el) => { el.classList.remove('_is-active'); }); } }); })(); /* @end: .tabs-uno */",
