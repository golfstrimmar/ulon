  {
    "tag": "script",
    "text": "/* @component: .tabs */document.addEventListener('click', function (e) {\r\n  const btn = e.target.closest('.tabs__btn');\r\n\r\n  if (btn) {\r\n    const tabsContainer = btn.closest('.tabs');\r\n    const allBtns = tabsContainer.querySelectorAll('.tabs__btn');\r\n    const allPanes = tabsContainer.querySelectorAll('.tabs__pane');\r\n    const index = Array.from(allBtns).indexOf(btn);\r\n\r\n    allBtns.forEach(b => {\r\n      if (b !== btn) {\r\n        b.classList.remove('_is-active');\r\n      }\r\n    });\r\n\r\n    const isNowActive = btn.classList.toggle('_is-active');\r\n\r\n    allPanes.forEach(p => p.classList.remove('_is-active'));\r\n\r\n    if (isNowActive && allPanes[index]) {\r\n      allPanes[index].classList.add('_is-active');\r\n    }\r\n\r\n  } else if (!e.target.closest('.tabs')) {\r\n    document.querySelectorAll('.tabs__btn, .tabs__pane').forEach(el => {\r\n      el.classList.remove('_is-active');\r\n    });\r\n  }\r\n});",
