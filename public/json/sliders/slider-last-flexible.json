    "tag": "script",
    "text": "/* @component: .slider-last-flexible */ (function () { const RIGHTMOST_OFFSET = 2; function updateExpandedSlide(swiper) { if (!swiper || !swiper.slides || swiper.slides.length === 0) return; const totalSlides = swiper.slides.length; const targetIndex = (swiper.activeIndex + RIGHTMOST_OFFSET) % totalSlides; swiper.slides.forEach((slide, index) => { if (index === targetIndex) { slide.classList.add('is-expanded'); } else { slide.classList.remove('is-expanded'); } }); } function initCarousel() { document.querySelectorAll('.carouselSwiperFlexible').forEach(function (container) { if (container.dataset.init === 'true') return; container.dataset.init = 'true'; const wrapper = container.querySelector('.swiper-wrapper'); if (wrapper) { const originalSlides = Array.from(wrapper.children); if (originalSlides.length > 0 && originalSlides.length < 10) { const repeatCount = Math.ceil(10 / originalSlides.length); for (let i = 1; i < repeatCount; i++) { originalSlides.forEach((slide) => { wrapper.appendChild(slide.cloneNode(true)); }); } } } const parentSection = container.closest('.slider-last-flexible') || container.parentElement; new Swiper(container, { slidesPerView: 'auto', spaceBetween: 16, loop: true, loopAdditionalSlides: 8, loopPreventsSliding: false, watchSlidesProgress: true, grabCursor: true, speed: 450, navigation: { nextEl: parentSection ? parentSection.querySelector('.carousel__btn--next') : null, prevEl: parentSection ? parentSection.querySelector('.carousel__btn--prev') : null }, observer: true, observeParents: true, on: { init: function () { updateExpandedSlide(this); }, beforeSlideChangeStart: function () { updateExpandedSlide(this); }, slideChangeTransitionStart: function () { updateExpandedSlide(this); }, loopFix: function () { updateExpandedSlide(this); } } }); }); } if (!document.getElementById('carousel-dynamic-sizes-css')) { const style = document.createElement('style'); style.id = 'carousel-dynamic-sizes-css'; style.textContent = '.carouselSwiperFlexible { max-width: 776px !important; width: 100%; overflow: hidden; } .carouselSwiperFlexible .swiper-slide { width: 172px !important; flex-shrink: 0; box-sizing: border-box; transition: width 0.45s cubic-bezier(0.25, 1, 0.5, 1); overflow: hidden; } .carouselSwiperFlexible .swiper-slide.is-expanded { width: 400px !important; } .carousel__btn--next, .carousel__btn--prev { pointer-events: auto !important; opacity: 1 !important; cursor: pointer !important; }'; document.head.appendChild(style); } if (!document.getElementById('swiper-css')) { const link = document.createElement('link'); link.id = 'swiper-css'; link.rel = 'stylesheet'; link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css'; document.head.appendChild(link); } if (typeof Swiper !== 'undefined') { initCarousel(); } else { let script = document.getElementById('swiper-js'); if (!script) { script = document.createElement('script'); script.id = 'swiper-js'; script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js'; document.head.appendChild(script); } script.addEventListener('load', initCarousel); } })(); /* @end: .slider-last-flexible */",
