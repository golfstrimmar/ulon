    "class": "footer  style-footer",
    "style": "color: var(--color-white); padding: 60px 0 30px; font-family: var(--font-inter); border-top: 1px solid rgba(255, 255, 255, 0.1); background: var(--bg-base); .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; } .footer__body { display: grid; grid-template-columns: 1fr; gap: 40px; margin-bottom: 40px; } .footer__columns { display: grid; grid-template-columns: repeat(5, 1fr); gap: 30px; } .footer__main { display: flex; flex-direction: column; gap: 20px; } .footer__logo { display: flex; align-items: center; gap: 12px; text-decoration: none; } .footer__logo img { width: 32px; height: 32px; min-width: 32px; } .footer__logo p { color: var(--color-white); font-weight: 800; font-size: 20px; margin: 0; letter-spacing: 0.5px; } .footer__text { color: color-mix(in srgb, var(--color-white) 60%, transparent); line-height: 1.6; font-size: 14px; margin: 0; } .footer__title { color: var(--color-white); font-size: 14px; font-weight: 700; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1.2px; } .footer__list { display: grid; gap: 12px; list-style: none; padding: 0; margin: 0; } .footer__list a { color: color-mix(in srgb, var(--color-white) 60%, transparent); text-decoration: none; transition: 0.3s; font-size: 14px; &:hover { color: var(--accent); } } .footer__info { color: color-mix(in srgb, var(--color-white) 60%, transparent); font-size: 14px; line-height: 1.5; } .footer__info--hours { color: var(--sky-500); font-size: 14px; line-height: 1.5; font-weight: 500; } .footer__socs { display: flex; flex-direction: row; align-items: center; gap: 10px; } .footer__socs a { color: var(--color-white); text-decoration: none; transition: all 0.2s ease-in-out; font-size: 14px; height: 20px; width: 20px; display: inline-block; &:hover { color: var(--accent); } } .footer__socs .svg-node-wrapper { transition: all 0.2s ease-in-out; display: inline-block; line-height: 0; vertical-align: middle; width: 100%; height: 100%; } .footer__socs svg { width: 100%; height: 100%; display: block; } .footer__bottom { display: grid; padding-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.05); justify-content: center; } .footer__copy { color: color-mix(in srgb, var(--color-white) 60%, transparent); font-size: 13px; letter-spacing: 0.5px; }",
