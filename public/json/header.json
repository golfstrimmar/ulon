    "tag": "script",
    "text": "/* @component: .burger */ document.addEventListener('DOMContentLoaded', () => { const burger = document.querySelector('.burger'); const info = document.querySelector('.header__info'); if (!burger || !info) return; const checkWidth = () => { if (window.innerWidth > 991) { burger.classList.remove('_active'); info.classList.remove('_active'); } }; burger.addEventListener('click', (e) => { e.preventDefault(); burger.classList.toggle('_active'); info.classList.toggle('_active'); }); checkWidth(); window.addEventListener('resize', checkWidth); }); /* @component: .js-container-input */ (function () { document.addEventListener('DOMContentLoaded', function () { document.querySelectorAll('fieldset').forEach(function (fs) { const label = fs.querySelector('label'); const legendSpan = fs.querySelector('legend span'); if (label && legendSpan) { legendSpan.innerHTML = label.innerHTML; } }); }); })(); /* @component: .header__menu */ (function () { document.addEventListener('DOMContentLoaded', function () { document.querySelectorAll('fieldset').forEach(function (fs) { const label = fs.querySelector('label'); const legendSpan = fs.querySelector('legend span'); if (label && legendSpan) { legendSpan.innerHTML = label.innerHTML; } }); }); })(); /* @component: .header__menu */ document.addEventListener('DOMContentLoaded', () => { const container = document.querySelector('.header__menu'); if (!container) return; const headItems = container.querySelectorAll('.menu__link'); if (!headItems.length) return; const clearAll = () => { headItems.forEach(el => el.classList.remove('_active')); }; headItems.forEach(el => { el.addEventListener('click', (e) => { e.preventDefault(); clearAll(); el.classList.add('_active'); }); }); });",
    "class": "",
    "style": "",
    "children": [],
    "attributes": {}
  },
