<file path="src/app/design/controllers/useFigmaTextsController.ts">
"use client";

import { useState, useEffect, useCallback, useRef } from "react";
import type { HtmlNode } from "@/types/HtmlNode";
import { getColorVariables } from "@/store/figmaColorStorage";
import { getGlobalScss, saveGlobalScss } from "@/store/htmlStorage";
import { setPixelPerfectImage } from "@/app/plaza/components/PreviewArea/hooks/usePixelPerfect";
import {
  buildColorMap,
  createHtmlNodeFromText,
  createHtmlNodeFromStructureItem,
  extractTextsFromJson,
  extractStructureFromJson,
  flattenStructureTexts,
  generateScssForTextItems,
  type ColorVariableMap,
  type FigmaTextItem,
} from "../models/figmaTextNode.model";
import { appendNodesToTree } from "../models/figmaTreeAppender";

export function useFigmaTextsController() {
  const [nodes, setNodes] = useState<HtmlNode[]>([]);
  const [colorMap, setColorMap] = useState<ColorVariableMap>(new Map());
  const [error, setError] = useState<string | null>(null);
  const [isColorsLoaded, setIsColorsLoaded] = useState(false);
  const [savingKey, setSavingKey] = useState<string | null>(null);

  // Хранилище исходных элементов текущего фрагмента для генерации SCSS
  const currentTextItemsRef = useRef<FigmaTextItem[]>([]);

  const loadColors = useCallback(async () => {
    try {
      const vars = await getColorVariables();
      setColorMap(buildColorMap(vars || []));
      setIsColorsLoaded(true);
    } catch (err) {
      console.error("Failed to load color variables:", err);
      setError("Не удалось загрузить цвета из базы");
    }
  }, []);

  useEffect(() => {
    loadColors();

    const handleColorsSaved = (event: Event) => {
      const customEvent = event as CustomEvent<string[]>;
      if (customEvent.detail) {
        setColorMap(buildColorMap(customEvent.detail));
      } else {
        loadColors();
      }
    };

    window.addEventListener("figma_colors:saved", handleColorsSaved);
    return () => {
      window.removeEventListener("figma_colors:saved", handleColorsSaved);
    };
  }, [loadColors]);

  const processJson = useCallback(
    (rawJson: string) => {
      setError(null);

      if (!rawJson.trim()) {
        setNodes([]);
        currentTextItemsRef.current = [];
        return;
      }

      try {
        const structureItems = extractStructureFromJson(rawJson);
        const textItems = extractTextsFromJson(rawJson);

        if (structureItems.length > 0) {
          // Если есть иерархический блок structure — используем его:
          // 1. Порядок узлов в точности как в дереве
          // 2. Родительские блоки (div) группируют дочерние ноды
          const generatedNodes = structureItems.map((item) =>
            createHtmlNodeFromStructureItem(item, colorMap),
          );

          // СРАЗУ загоняем превью в PixelPerfect на этапе выжимки структуры из JSON!
          const sectionPreview = structureItems.find((s) => s.preview)?.preview;
          if (sectionPreview) {
            setPixelPerfectImage(
              sectionPreview,
              structureItems[0]?.name || "Figma Section Preview",
            ).catch(() => {});
          }

          // Для SCSS сохраняем тексты: из блока texts или рекурсивно из structure
          currentTextItemsRef.current =
            textItems.length > 0
              ? textItems
              : flattenStructureTexts(structureItems);

          setNodes(generatedNodes);
          return;
        }

        if (textItems.length === 0) {
          setError(
            "В переданном JSON не найден массив 'structure' или 'texts'",
          );
          setNodes([]);
          currentTextItemsRef.current = [];
          return;
        }

        // Фоллбэк: если пришел старый формат только с текстами
        currentTextItemsRef.current = textItems;

        const generatedNodes = textItems.map((item) =>
          createHtmlNodeFromText(item, colorMap),
        );

        setNodes(generatedNodes);
      } catch (err: unknown) {
        console.error("JSON parsing error:", err);
        setError("Ошибка парсинга JSON: проверьте формат входных данных");
        setNodes([]);
        currentTextItemsRef.current = [];
      }
    },
    [colorMap],
  );

  // Вспомогательная функция: добавление SCSS в базу Plaza (GlobalScss)
  const syncScssWithPlaza = async (items: FigmaTextItem[]) => {
    const newClassesScss = generateScssForTextItems(items, colorMap);
    if (!newClassesScss.trim()) return;

    const [currentGlobalScss, colorVars] = await Promise.all([
      getGlobalScss().catch(() => ""),
      getColorVariables().catch(() => []),
    ]);

    let updatedScss = currentGlobalScss || "";

    // Добавляем цвета в заголовок, если их еще нет в GlobalScss
    if (colorVars.length > 0 && !updatedScss.includes("$color-")) {
      const colorVarsHeader = colorVars.join("\n");
      updatedScss = `${colorVarsHeader}\n\n${updatedScss}`;
    }

    // Дописываем новые классы
    updatedScss = `${updatedScss.trim()}\n\n/* Figma Generated Classes */\n${newClassesScss}\n`;

    await saveGlobalScss(updatedScss);
  };

  // Добавление одной ноды в дерево
  const appendSingleNode = async (node: HtmlNode) => {
    if (!node._key) return;
    setSavingKey(node._key);

    try {
      // 1. Сохраняем ноду в дерево
      await appendNodesToTree(node);

      // 2. Находим соответствующий элемент и дописываем его SCSS-класс в базу
      const matchedItem = currentTextItemsRef.current.find(
        (item) =>
          (item.id || item.text) === node._key || item.className === node.class,
      );
      if (matchedItem) {
        await syncScssWithPlaza([matchedItem]);
      }

      // 3. Убираем добавленную ноду из буфера экрана
      setNodes((prev) => prev.filter((n) => n._key !== node._key));
      setSavingKey(null);
    } catch (err) {
      console.error("Ошибка сохранения ноды в базу:", err);
      setSavingKey(null);
    }
  };

  // Добавление всех сформированных нод в дерево
  const appendAllNodes = async () => {
    if (nodes.length === 0) return;
    setSavingKey("all");

    try {
      // 1. Сохраняем массив нод в дерево HTML
      await appendNodesToTree(nodes);

      // 2. Дописываем все SCSS-классы текущего фрагмента в GlobalScss плазы
      if (currentTextItemsRef.current.length > 0) {
        await syncScssWithPlaza(currentTextItemsRef.current);
      }

      // 3. Очищаем экран — фрагмент успешно ушел в дерево и стили сохранены
      setTimeout(() => {
        setNodes([]);
        currentTextItemsRef.current = [];
        setSavingKey(null);
      }, 500);
    } catch (err) {
      console.error("Ошибка сохранения всех нод в базу:", err);
      setSavingKey(null);
    }
  };

  return {
    nodes,
    error,
    isColorsLoaded,
    colorMapSize: colorMap.size,
    savingKey,
    processJson,
    appendSingleNode,
    appendAllNodes,
  };
}
</file>

<file path="src/app/design/models/figmaTreeAppender.ts">
import {
  getHtmlJson,
  saveHtmlJson,
  getAllHtmlJson,
  getGlobalScss,
  saveGlobalScss,
} from "@/store/htmlStorage";
import { updateClassInGlobalScss } from "@/lib/scssCompiler";
import type { HtmlNode } from "@/types/HtmlNode";

const DEFAULT_TREE_ID = "plaza_tree";

/**
 * Рекурсивный сбор классов и связанных CSS-свойств со всех переданных нод
 * (с поддержкой вложенного SCSS внутри style, например у .is -> img { ... })
 */
function extractNodeClassesAndStyles(
  node: HtmlNode,
  result: Map<string, string>,
) {
  if (node.class && node.style) {
    const classNames = node.class
      .split(/\s+/)
      .map((c) => c.trim().replace(/^\./, ""))
      .filter(Boolean);

    const trimmedStyle = node.style.trim();
    const hasNestedScss = trimmedStyle.includes("{");

    const scssProps = hasNestedScss
      ? `  ${trimmedStyle}`
      : trimmedStyle
          .split(";")
          .map((s) => s.trim())
          .filter(Boolean)
          .map((s) => `  ${s};`)
          .join("\n");

    if (scssProps) {
      for (const cls of classNames) {
        if (!result.has(cls)) {
          result.set(cls, scssProps);
        }
      }
    }
  }

  if (Array.isArray(node.children)) {
    for (const child of node.children) {
      extractNodeClassesAndStyles(child, result);
    }
  }
}

/**
 * Добавляет переданные ноды напрямую в конец активного дерева разметки
 * в базе, синхронизирует SCSS-стили классов в глобальный бандл (classes_css),
 * после чего диспатчит события обновления.
 */
export async function appendNodesToTree(
  newNodes: HtmlNode | HtmlNode[],
): Promise<HtmlNode[]> {
  const nodesToAdd = Array.isArray(newNodes) ? newNodes : [newNodes];
  if (nodesToAdd.length === 0) return [];

  // 1. Ищем существующее дерево: сначала пробуем plaza_tree
  let currentTree = await getHtmlJson(DEFAULT_TREE_ID);
  let targetId = DEFAULT_TREE_ID;

  // Если plaza_tree нет, смотрим первую попавшуюся запись в БД
  if (!currentTree) {
    const allTrees = await getAllHtmlJson();
    if (allTrees.length > 0) {
      targetId = allTrees[0].id;
      currentTree = allTrees[0].root;
    }
  }

  let nextTree: HtmlNode[];

  // 2. Встраиваем новые ноды напрямую в структуру
  if (!currentTree) {
    // Дерево ещё пустое — новые ноды становятся корнем
    nextTree = nodesToAdd;
  } else if (Array.isArray(currentTree)) {
    // Дерево — плоский массив: докидываем в конец списка
    nextTree = [...currentTree, ...nodesToAdd];
  } else {
    // Дерево — один корневой объект: добавляем в его children
    const existingChildren = Array.isArray(currentTree.children)
      ? currentTree.children
      : [];

    nextTree = [
      {
        ...currentTree,
        children: [...existingChildren, ...nodesToAdd],
      },
    ];
  }

  // 3. Сохраняем обновленное дерево в IndexedDB
  await saveHtmlJson(targetId, nextTree);

  // 4. Синхронизируем стили классов из нод в глобальный SCSS (classes_css)
  try {
    const classStylesMap = new Map<string, string>();
    for (const node of nodesToAdd) {
      extractNodeClassesAndStyles(node, classStylesMap);
    }

    if (classStylesMap.size > 0) {
      let currentScss = await getGlobalScss().catch(() => "");
      for (const [cls, scssProps] of classStylesMap.entries()) {
        const fullSnippet = `.${cls} {\n${scssProps}\n}`;
        currentScss = updateClassInGlobalScss(currentScss, cls, fullSnippet);
      }
      await saveGlobalScss(currentScss);

      if (typeof window !== "undefined") {
        window.dispatchEvent(
          new CustomEvent("plaza-styles-updated", { detail: currentScss }),
        );
      }
    }
  } catch (scssErr) {
    console.error("Ошибка синхронизации SCSS стилей для нод:", scssErr);
  }

  // 5. Оповещаем всю систему об обновлении дерева
  if (typeof window !== "undefined") {
    window.dispatchEvent(
      new CustomEvent("plaza-tree-updated", { detail: nextTree }),
    );
  }

  return nextTree;
}
